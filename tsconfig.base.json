{
	"compileOnSave": false,
	"compilerOptions": {
		"sourceMap": true,
		"declaration": false,
		"moduleResolution": "node",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "es2015",
		"module": "esnext",
		"lib": ["es2020", "dom"],
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"paths": {
			"@event-platform/shared-types": ["./libs/shared-types/src/index.ts"],
			"@event-platform/domain": ["./libs/domain/src/index.ts"]
		}
	},
	"exclude": ["node_modules", "tmp"]
}
