{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc/apps/api",
		"rootDir": "src",
		"module": "commonjs",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"jest.config.ts",
		"jest.config.cts",
		"src/**/*.spec.ts",
		"src/**/*.test.ts"
	]
}
